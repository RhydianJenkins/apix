active: pokemon-example
domains:
    pokemon-example:
        base: https://pokeapi.co/
        http:
            openapispecpath: https://raw.githubusercontent.com/PokeAPI/pokeapi/master/openapi.yml
        headers:
            X-foo: bar
        # PokeAPI doesn't actually need auth - this just illustrates the pattern
        # `apix auth` will run this command as a way for you to bring your own auth
        auth:
            command: apix set-header authorization "Bearer $(date +%s)"
        protocol: http
